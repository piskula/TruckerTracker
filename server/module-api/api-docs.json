    "/api/v1/issue/{id}/comment": {
      "post": {
        "tags": [
          "Issues"
        ],
        "summary": "Add comment",
        "operationId": "addComment",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "string"
              }
