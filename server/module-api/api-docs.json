                    {
                      "$ref": "#/components/schemas/AssigneeChange"
                    },
                    {
                      "$ref": "#/components/schemas/Comment"
                    },
                    {
                      "$ref": "#/components/schemas/DescriptionChange"
                    },
                    {
                      "$ref": "#/components/schemas/PriorityChange"
                    },
                    {
                      "$ref": "#/components/schemas/StatusChange"
                    },
                    {
                      "$ref": "#/components/schemas/TitleChange"
                    },
                    {
                      "$ref": "#/components/schemas/VehicleChange"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/issue/{id}/cancel": {
