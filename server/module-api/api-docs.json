                }
              }
            }
          }
        }
      }
    },
    "/api/v1/checklist-question": {
      "get": {
        "tags": [
          "Checklist Questions"
        ],
        "summary": "Get checklist questions",
        "operationId": "getChecklistQuestionList",
        "parameters": [
          {
            "name": "Accept-Language",
            "in": "header",
            "required": false,
            "description": "Preferred question languages, including optional quality weights. Defaults to Slovak when absent or no translation matches.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ChecklistQuestionDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/checklist-response/create": {
      "post": {
        "tags": [
          "Checklist Responses"
        ],
        "summary": "Create checklist response",
        "operationId": "createChecklistResponse",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChecklistResponseCreateDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ChecklistResponseDto"
                }
              }
            }
          },
          "409": {
            "description": "The current user already submitted a checklist this week"
          }
        }
      }
    },
    "/api/v1/checklist-response/status": {
      "get": {
        "tags": [
          "Checklist Responses"
        ],
        "summary": "Get the current user's checklist status for this week",
        "operationId": "getChecklistStatus",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ChecklistStatusDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/issue/byId/{id}": {
      "get": {
        "tags": [
          "Issues"
        ],
        "summary": "Get issue by ID",
        "operationId": "getIssue",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/IssueDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/push-device": {
      "get": {
        "tags": [
          "Push Devices"
        ],
        "summary": "Get registered push device",
        "operationId": "getPushDevice",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PushDeviceDto"
                }
              }
            }
          },
          "204": {
            "description": "No push device is registered"
          }
        }
      },
      "put": {
        "tags": [
          "Push Devices"
        ],
        "summary": "Register push device, taking over from the previously registered device",
        "operationId": "registerPushDevice",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PushDeviceRegistrationDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PushDeviceDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/push-device/{firebaseInstallationId}": {
      "delete": {
        "tags": [
          "Push Devices"
        ],
        "summary": "Delete push device if this Firebase Installation ID holds the push device slot",
        "operationId": "deletePushDevice",
        "parameters": [
          {
            "name": "firebaseInstallationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "patch": {
        "tags": [
          "Push Devices"
        ],
        "summary": "Update Firebase Installation ID of the registered push device",
        "description": "The path holds the Firebase Installation ID the app registered last, the body the current one.",
        "operationId": "updatePushDevice",
        "parameters": [
          {
            "name": "firebaseInstallationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PushDeviceUpdateDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "409": {
            "description": "The Firebase Installation ID in the path does not hold the push device slot"
          }
        }
      }
    },
    "/api/v1/push/backchannel-logout": {
      "post": {
        "tags": [
          "Push"
        ],
        "summary": "Handle an OpenID Connect back-channel logout notification from Keycloak",
        "operationId": "processBackchannelLogout",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "required": [
                  "logout_token"
                ],
                "type": "object",
                "properties": {
                  "logout_token": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "The logout token is invalid"
          }
        },
        "security": []
      }
    }
  },
  "components": {
    "schemas": {
      "IssueFilterDto": {
        "type": "object",
        "properties": {
          "statuses": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "OPEN",
                "IN_PROGRESS",
                "DONE",
                "CANCELED"
              ]
            }
          },
          "vehicleIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          },
          "accountIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "AccountDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          }
        }
      },
      "IssueDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "IN_PROGRESS",
              "DONE",
              "CANCELED"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "P1_HIGH",
              "P3_MEDIUM",
              "P5_LOW"
            ]
          },
          "vehicle": {
            "$ref": "#/components/schemas/VehicleDto"
          },
          "reportedBy": {
            "$ref": "#/components/schemas/AccountDto"
          },
          "assignedTo": {
            "$ref": "#/components/schemas/AccountDto"
          },
          "repairType": {
            "type": "string",
            "enum": [
              "DAMAGE",
              "FAULT",
              "INSTALLATION"
            ]
          },
          "vehicleSystem": {
            "type": "string",
            "enum": [
              "ELECTRICAL",
              "TIRES",
              "BODY",
              "ENGINE",
              "DRIVETRAIN",
              "BRAKES",
              "AIR",
              "TARP",
              "COOLING",
              "OTHER"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PageDtoIssueDto": {
        "type": "object",
        "properties": {
          "totalElements": {
            "type": "integer",
            "format": "int64"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32"
          },
          "number": {
            "type": "integer",
            "format": "int32"
          },
          "size": {
            "type": "integer",
            "format": "int32"
          },
          "numberOfElements": {
            "type": "integer",
            "format": "int32"
          },
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IssueDto"
            }
          }
        }
      },
      "VehicleDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "licensePlate": {
            "type": "string"
          },
          "make": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "TRUCK",
              "TRAILER"
            ]
          }
        }
      },
      "IssueAttachmentDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "filename": {
            "type": "string"
          },
          "contentType": {
            "type": "string"
          },
          "sizeBytes": {
            "type": "integer",
            "format": "int64"
          },
          "uploadedBy": {
            "$ref": "#/components/schemas/AccountDto"
          },
          "uploadedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "StartIssueDto": {
        "type": "object",
        "properties": {
          "repairType": {
