#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
app_dir="$repo_root/app"

mapfile -t staged_files < <(git diff --cached --name-only --diff-filter=ACMR)

if [ ${#staged_files[@]} -eq 0 ]; then
    exit 0
fi

# Walks up from a staged file to the nearest ancestor directory containing a
# build.gradle(.kts) - i.e. its Gradle module root - and prints that module's
# Gradle path. Derived from the directory layout, so new modules need no
# changes here.
module_path_for() {
    local dir
    dir="$repo_root/$(dirname "$1")"

    while [ "$dir" != "$app_dir" ] && [ "$dir" != "$repo_root" ] && [ "$dir" != "/" ]; do
        if [ -f "$dir/build.gradle.kts" ] || [ -f "$dir/build.gradle" ]; then
            local rel="${dir#"$app_dir"/}"
            echo ":${rel//\//:}"
            return 0
        fi
        dir="$(dirname "$dir")"
    done

    return 1
}

declare -A affected_modules=()

for f in "${staged_files[@]}"; do
    case "$f" in
        *.kt) ;;
        *) continue ;;
    esac
    case "$f" in
        app/build-logic/*) continue ;; # separate Gradle build, not addressable from app/'s gradlew
        app/*) ;;
        *) continue ;;
    esac

    if module=$(module_path_for "$f"); then
        affected_modules["$module"]=1
    fi
done

if [ ${#affected_modules[@]} -eq 0 ]; then
    exit 0
fi

tasks=()
for module in "${!affected_modules[@]}"; do
    tasks+=("${module}:spotlessApply")
done

echo "Running Spotless on: ${tasks[*]}"
(cd "$app_dir" && ./gradlew "${tasks[@]}" --console=plain -q)

# Re-stage in case Spotless reformatted any of the staged files.
git add -- "${staged_files[@]}"

exit 0
